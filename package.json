{
  "name": "churchos",
  "private": true,
  "version": "1.0.0",
  "description": "ChurchOS unified Cloudflare-first SaaS monorepo.",
  "main": "index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=@churchos/api",
    "preview": "node scripts/local-preview.js",
    "db:migrate": "npm --workspace=@churchos/api run db:migrate",
    "db:seed": "npm --workspace=@churchos/api run db:seed",
    "db:reset": "npm --workspace=@churchos/api run db:reset",
    "test": "npm run test --workspaces"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalChurchOS/documentation.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/DigitalChurchOS/documentation/issues"
  },
  "homepage": "https://github.com/DigitalChurchOS/documentation#readme",
  "dependencies": {
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
